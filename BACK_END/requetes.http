# ==================================================
#   API La Remise — Requêtes de test
# ==================================================

# ---------------------------------------------
#   GET /api/objets
# ---------------------------------------------

### 200 - Liste des objets sans filtre
GET http://localhost:3000/api/objets?statut=&categorie_id=

### 200 - Liste des objets filtrée par statut
GET http://localhost:3000/api/objets?statut=recycle&categorie_id=

### 200 - Liste des objets filtrée par statut et catégorie
GET http://localhost:3000/api/objets?statut=recycle&categorie_id=2

### 400 - Statut invalide
GET http://localhost:3000/api/objets?statut=toto&categorie_id=2

### 400 - categorie_id non numérique
GET http://localhost:3000/api/objets?statut=recycle&categorie_id=abc

### 200 - L'objet existe
GET http://localhost:3000/api/objets/2

### 404 - L'objet n'existe pas
GET http://localhost:3000/api/objets/777

### 400 - L'id doit être numérique
GET http://localhost:3000/api/objets/toto

# ---------------------------------------------
#   GET /api/categories
# ---------------------------------------------

### 200 - Liste des catégories (pour le filtre)
GET http://localhost:3000/api/categories

# ---------------------------------------------
#   GET /api/statuts
# ---------------------------------------------

### 200 - Liste des statuts (pour le filtre)
GET http://localhost:3000/api/statuts

# ---------------------------------------------
#   PATCH /api/objets/:id/statut
# ---------------------------------------------

### 200 - Changement de statut et de prix
PATCH http://localhost:3000/api/objets/7/statut
Content-Type: application/json

{
  "statut": "en_rayon",
  "prix": 20
}

### 200 - Changement de statut seul (le prix est conservé)
PATCH http://localhost:3000/api/objets/7/statut
Content-Type: application/json

{
  "statut": "en_rayon"
}

### 400 - Statut non renseigné
PATCH http://localhost:3000/api/objets/7/statut
Content-Type: application/json

{}

### 400 - Statut invalide (hors enum statut_objet)
PATCH http://localhost:3000/api/objets/7/statut
Content-Type: application/json

{
  "statut": "en_vente"
}

### 404 - L'objet n'existe pas
PATCH http://localhost:3000/api/objets/777/statut
Content-Type: application/json

{
  "statut": "en_rayon",
  "prix": 15
}
 
### PAGE 5 DEPOTS LISTE AFFICHER
GET http://localhost:3000/api/depots

# ---------------------------------------------
#   GET /api/depots/:id
# ---------------------------------------------

### 200 - Fiche d'un dépôt avec ses objets
GET http://localhost:3000/api/depots/6

# ---------------------------------------------
#   POST /api/personnes
# ---------------------------------------------

### 201 - Création d'une personne (ajout d'une donatrice)
POST http://localhost:3000/api/personnes
Content-Type: application/json

{
  "nom": "Lio",
  "prenom": "Jean-Paul",
  "telephone": "0667888890",
  "adherente": true
}

# ---------------------------------------------
#   POST /api/depots
# ---------------------------------------------

### 201 - Création d'un dépôt
POST http://localhost:3000/api/depots
Content-Type: application/json

{
  "personne_id": 3,
  "type": "boutique",
  "date_depot": "2026-10-15"
}

# ---------------------------------------------
#   POST /api/depots/:id/objets
# ---------------------------------------------

### 201 - Ajout d'un objet à un dépôt
POST http://localhost:3000/api/depots/5/objets
Content-Type: application/json

{
  "libelle": "Veste en jean",
  "poids_kg": 0.8,
  "etat_arrivee": "bon_etat",
  "categorie_id": 2
}

# ---------------------------------------------
#   GET /api/benevoles
# ---------------------------------------------

### 200 - Liste des bénévoles (pour l'écran « Qui es-tu ? »)
GET http://localhost:3000/api/benevoles

